{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-top",
          "type": "block",
          "content": {
            "mod": "rex-sidebar",
            "props": {
              "part": "top"
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "rex-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "rex-agents"
              }
            }
          ],
          "active": "spaces"
        },
        {
          "id": "status-card",
          "type": "block",
          "size": {
            "px": 52
          },
          "content": {
            "mod": "rex-status"
          }
        },
        {
          "id": "machines",
          "type": "block",
          "size": {
            "px": 240
          },
          "content": {
            "mod": "rex-machines"
          }
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "rex-usage"
          },
          "size": {
            "px": 86
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "rex-sidebar",
            "props": {
              "part": "footer"
            }
          },
          "size": {
            "px": 44
          }
        }
      ],
      "size": {
        "px": 280
      },
      "min": 180,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "rex-tabs"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "background",
                  "radius": 0,
                  "gap": 1
                }
              },
              "background": "border"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "divider": {
            "width": 1,
            "color": "border"
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "background",
  "terminal_padding": [
    8,
    8
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    16
  ]
}
