{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    16,
    16
  ],
  "background": "background",
  "terminal_padding": [
    8,
    8
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 280
      },
      "min": 180,
      "max": 480,
      "background": "chrome",
      "children": [
        {
          "id": "sidebar-top",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "rex-sidebar",
            "props": {
              "part": "top"
            }
          }
        },
        {
          "id": "sidebar-list",
          "type": "block",
          "size": {
            "weight": 1
          },
          "content": {
            "mod": "rex-sidebar",
            "props": {
              "part": "list"
            }
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "rex-sidebar",
            "props": {
              "part": "footer"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 40
          },
          "window_drag": true,
          "content": {
            "mod": "rex-tabs"
          }
        },
        {
          "id": "main",
          "type": "block",
          "background": "border",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 1,
              "radius": 0,
              "background": "background",
              "lone": false
            }
          }
        }
      ]
    }
  ]
}
