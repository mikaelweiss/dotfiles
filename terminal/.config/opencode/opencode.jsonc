{
  "$schema": "https://opencode.ai/config.json",
  "model": "novita-ai/deepseek/deepseek-v4.1-flash",
  "small_model": "novita-ai/deepseek/deepseek-v4.1-flash",
  "disabled_providers": ["zai"],
  "provider": {
    "novita-ai": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache_read": 0.003
          }
        }
      }
    }
  }
}
