#!/bin/zsh
# One-time (re)setup of the mutagen session that syncs ~/code/dotfiles
# between this Mac and elm, the always-on hub. Ignore defaults come from
# ~/.mutagen.yml, plus whatever git reports as ignored. Idempotent: an
# existing session is left alone, so terminate it first to rebuild its
# ignore list.
set -e
source "${0:A:h}/sync-lib.zsh"

create() {
  local name=$1 root=$2
  if mutagen sync list "$name" >/dev/null 2>&1; then
    echo "session '$name' already exists"
    return
  fi
  local -a ig
  ig=( ${(f)"$(gitignored "$root")"} )
  mutagen sync create --name="$name" \
    --sync-mode=two-way-resolved \
    --symlink-mode=posix-raw \
    $ig \
    "$hub:$root" "$root"
}

sessions | while read -r name root; do
  create "$name" "$root"
done
mutagen sync list
