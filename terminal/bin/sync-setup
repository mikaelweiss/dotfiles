#!/bin/zsh
# Sets up the mutagen sessions between this Mac and elm, the always-on hub,
# and ends hub sessions that sessions() no longer lists. Ignore defaults come
# from ~/.mutagen.yml, plus whatever git reports as ignored in each synced
# repo. Idempotent: existing sessions are left alone, so terminate a session
# first to rebuild its ignore list.
set -e
source "${0:A:h}/sync-lib.zsh"

create() {
  local name=$1 root=$2
  if mutagen sync list "$name" >/dev/null 2>&1; then
    echo "session '$name' already exists"
    return
  fi
  local -a ig
  ig=( ${(f)"$(gitignored "$root")"} )
  mutagen sync create --name="$name" \
    --sync-mode=two-way-resolved \
    --symlink-mode=posix-raw \
    $ig \
    "$hub:$root" "$root"
}

local -a wanted
wanted=( ${(f)"$(sessions | cut -d' ' -f1)"} )
mutagen sync list --template '{{range .}}{{.Name}} {{.Alpha.Host}}{{"\n"}}{{end}}' |
  while read -r name host; do
    if [[ $host == $hub ]] && (( ! ${wanted[(Ie)$name]} )); then
      mutagen sync terminate "$name"
      echo "ended session '$name': it is no longer in sessions()"
    fi
  done

sessions | while read -r name root; do
  create "$name" "$root"
done
mutagen sync list
