#!/usr/bin/env python3
"""Print a fresh ChatGPT access token for Codex.

Wolf holds the one Codex login. Every other machine asks wolf over ssh, so a
single refresh token serves them all. Refresh tokens are single-use: the lock
keeps two callers from spending the same one.

To sign in again on wolf: codex login
"""
import base64
import fcntl
import json
import os
import socket
import sys
import time
import urllib.request
from datetime import datetime, timezone

HOST = "wolf"
AUTH = os.path.expanduser("~/.codex/auth.json")
CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"
REFRESH_URL = "https://auth.openai.com/oauth/token"
MIN_REMAINING_S = 600


def expires_at(jwt):
    payload = jwt.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return json.loads(base64.urlsafe_b64decode(payload))["exp"]


def refresh(auth):
    body = json.dumps({
        "client_id": CLIENT_ID,
        "grant_type": "refresh_token",
        "refresh_token": auth["tokens"]["refresh_token"],
    }).encode()
    req = urllib.request.Request(REFRESH_URL, body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        fresh = json.load(resp)
    for key in ("id_token", "access_token", "refresh_token"):
        if fresh.get(key):
            auth["tokens"][key] = fresh[key]
    auth["last_refresh"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    tmp = AUTH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(auth, f, indent=2)
    os.replace(tmp, AUTH)


def main():
    if socket.gethostname().split(".")[0].lower() != HOST:
        os.execvp("ssh", ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                          HOST, os.path.abspath(__file__)])
    with open(AUTH + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(AUTH) as f:
            auth = json.load(f)
        if expires_at(auth["tokens"]["access_token"]) - time.time() < MIN_REMAINING_S:
            refresh(auth)
    sys.stdout.write(auth["tokens"]["access_token"])


if __name__ == "__main__":
    main()
