#!/bin/zsh
# Closes the herdr tab or Herdr app tab of a worktree
# that is gone (wt remove, or wt merge with removal), so it doesn't linger.
# Idempotent, so it is safe to fire from both post-remove and post-merge.
# Usage: worktree-cleanup <branch> <worktree_path>
branch=$1
worktree=$2

if [ -d "$worktree" ]; then
  # wt merge fires post-merge before its backgrounded removal deletes the
  # worktree — hand off to a detached copy that waits for it to vanish
  if [ -z "${WORKTREE_CLEANUP_REEXEC:-}" ]; then
    WORKTREE_CLEANUP_REEXEC=1 nohup "$0" "$branch" "$worktree" >/dev/null 2>&1 &!
    exit 0
  fi
  for i in {1..60}; do
    sleep 0.5
    [ -d "$worktree" ] || break
  done
  # still present after the wait: merge --no-remove, leave everything open
  [ -d "$worktree" ] && exit 0
fi

if [ -n "${HERDR_ENV:-}" ]; then
  tab_id=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID" | jq -r --arg b "$branch" '.result.tabs[] | select(.label == $b) | .tab_id' | head -n1)
  [ -n "$tab_id" ] && nohup sh -c "herdr tab close $tab_id" >/dev/null 2>&1 &
elif [ -n "${HC_TERMINAL_ID:-}" ] && command -v herdr-app >/dev/null; then
  tab_id=$(herdr-app ls | jq -r --arg t "$HC_TERMINAL_ID" --arg b "$branch" '[.spaces[] | select(any(.tabs[].terminals[]; .terminal == $t)) | .tabs[] | select(.name == $b)][0].id // empty')
  [ -n "$tab_id" ] && nohup herdr-app do tab.close --id "$tab_id" --confirmed true >/dev/null 2>&1 &
fi

exit 0
