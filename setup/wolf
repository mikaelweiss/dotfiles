#!/bin/zsh
# Sets up a Mac mini as wolf, then checks every piece. Run it on the Mac,
# logged in as mikaelweiss:
#   /bin/zsh -c "$(curl -fsSL https://raw.githubusercontent.com/MikaelWeiss/dotfiles/main/setup/wolf)"
# Every step skips what is already done and repairs what isn't, so rerun it
# whenever a check fails or the config changes.
set -euo pipefail

host=wolf
user=mikaelweiss
github_user=MikaelWeiss
dotfiles=$HOME/code/dotfiles
rotate=$HOME/.local/share/claude-rotate
runners=$HOME/actions-runners
java_home=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home

# The machines whose claude reaches the proxy on wolf, each with its own device key.
claude_machines=(wolf mikaels-macbook-pro mikaels-macbook-air elm)
# repo:runner-name, matching the runners the old wolf served.
runner_specs=(
  mikaelweiss/aspen-grove:wolf
  mikaelweiss/aspen-grove:wolf-2
  mikaelweiss/aspen-grove:wolf-3
  mikaelweiss/timbre:wolf-timbre
)

step() { print -P "\n%F{blue}==>%f %B$1%b" }
note() { print -P "%F{yellow}$1%f" }
pause() { print -P "%F{yellow}$1%f"; read -r "?Press Enter to continue. " }
ask() { local reply; read -r "reply?$1 [y/N] "; [[ $reply == [yY]* ]] }
remote_login_on() { nc -z -G 2 localhost 22 >/dev/null 2>&1 }
device_key() { /usr/bin/python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('devices', {}).get(sys.argv[2], ''))" $rotate/config.json $1 }

[[ $(uname) == Darwin ]] || { echo "Run this on the Mac mini."; exit 1 }
[[ $(id -un) == $user ]] || { echo "Log in as $user and run it again."; exit 1 }

sudo -v
while true; do sudo -n true; sleep 50; kill -0 $$ 2>/dev/null || exit; done 2>/dev/null &

step "Name this Mac $host"
for key in ComputerName LocalHostName HostName; do
  [[ $(scutil --get $key 2>/dev/null) == $host ]] || sudo scutil --set $key $host
done

step "Homebrew"
[[ -x /opt/homebrew/bin/brew ]] ||
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
eval "$(/opt/homebrew/bin/brew shellenv)"

step "Lix"
[[ -x /nix/var/nix/profiles/default/bin/nix ]] ||
  curl -sSf -L https://install.lix.systems/lix | sh -s -- install --no-confirm
set +u
source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
set -u

step "Dotfiles"
if [[ -d $dotfiles/.git ]]; then
  git -C $dotfiles pull -q --rebase --autostash
else
  mkdir -p ${dotfiles:h}
  git clone https://github.com/$github_user/dotfiles.git $dotfiles
fi
# The build runs as root against a repo mikaelweiss owns, which git refuses by default.
safe=$(sudo -H git config --global --get-all safe.directory 2>/dev/null || true)
[[ $safe == *$dotfiles* ]] || sudo -H git config --global --add safe.directory $dotfiles

step "Remote Login"
until remote_login_on; do
  sudo systemsetup -setremotelogin on >/dev/null 2>&1 || true
  if remote_login_on; then break; fi
  open "x-apple.systempreferences:com.apple.Sharing-Settings.extension"
  pause "Turn on Remote Login in System Settings > General > Sharing."
done
# wolf's activation adds pip to this group, and fails when the group is missing.
# Creating it with admin inside keeps Remote Login to admins, plus pip.
if ! dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1; then
  sudo dseditgroup -o create -q com.apple.access_ssh
  sudo dseditgroup -o edit -a admin -t group com.apple.access_ssh
fi

step "nix-darwin"
if [[ -x /run/current-system/sw/bin/darwin-rebuild ]]; then
  sudo /run/current-system/sw/bin/darwin-rebuild switch --flake $dotfiles/nix#$host
else
  for f in /etc/nix/nix.conf /etc/nix/nix.custom.conf; do
    if [[ -e $f && ! -L $f ]]; then sudo mv $f $f.before-nix-darwin; fi
  done
  sudo /nix/var/nix/profiles/default/bin/nix --extra-experimental-features 'nix-command flakes' \
    run nix-darwin/master#darwin-rebuild -- switch --flake $dotfiles/nix#$host
fi
export PATH=/run/current-system/sw/bin:$PATH

step "Go build cache on the internal disk"
go_cache=$HOME/Library/Caches/go-build
if [[ -L $go_cache ]]; then rm $go_cache; fi

step "Link dotfiles"
for f in $HOME/.zshrc $HOME/.gitconfig; do
  if [[ -e $f && ! -L $f ]]; then mv $f $f.before-dotfiles; fi
done
(cd $dotfiles && stow agents claude codex git terminal)

step "oh-my-zsh and Powerlevel10k"
[[ -d $HOME/.oh-my-zsh ]] ||
  KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
p10k=$HOME/.oh-my-zsh/custom/themes/powerlevel10k
[[ -d $p10k ]] || git clone --depth=1 https://github.com/romkatv/powerlevel10k.git $p10k

step "GitHub"
mkdir -p -m 700 $HOME/.ssh
[[ -f $HOME/.ssh/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N "" -C "$user@$host" -f $HOME/.ssh/id_ed25519
grep -q '^github.com ' $HOME/.ssh/known_hosts 2>/dev/null ||
  curl -fsSL https://api.github.com/meta | jq -r '.ssh_keys[] | "github.com " + .' >> $HOME/.ssh/known_hosts
gh auth status >/dev/null 2>&1 || gh auth login --hostname github.com --git-protocol ssh --web
git -C $dotfiles remote set-url origin git@github.com:$github_user/dotfiles.git

step "Only the Air and Pro can ssh in"
# nix/hub-keys.nix lists them, and sshd also reads this file.
rm -f $HOME/.ssh/authorized_keys

step "Tailscale"
[[ $(sudo brew services info tailscale --json | jq -r '.[0].running') == true ]] ||
  sudo brew services start tailscale
for i in {1..30}; do
  ts=$(tailscale status 2>&1 || true)
  [[ $ts == *"failed to connect"* ]] || break
  sleep 1
done
if ! tailscale status >/dev/null 2>&1; then
  pause "Delete the old wolf at https://login.tailscale.com/admin/machines first, so this Mac gets the name wolf."
  sudo tailscale up
fi
# The macOS firewall drops inbound connections to nix binaries, so these
# services listen on localhost and Tailscale carries the tailnet's traffic in.
for port in 8484 9100; do
  tailscale serve status --json 2>/dev/null | jq -e ".TCP[\"$port\"]" >/dev/null ||
    sudo tailscale serve --bg --tcp $port tcp://127.0.0.1:$port
done

step "Record the new wolf in the dotfiles"
host_key=$(awk '{print $1 " " $2}' /etc/ssh/ssh_host_ed25519_key.pub)
tailnet_ip=$(tailscale ip -4)
lan_ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)

sed -i '' -E "/knownHosts\.wolf/,/};/{
  s|\"wolf\" \"[0-9.]+\"|\"wolf\" \"$tailnet_ip\"|
  s|publicKey = \"[^\"]*\"|publicKey = \"$host_key\"|
}" $dotfiles/nix/shared.nix
if [[ -n $lan_ip ]]; then
  sed -i '' -E "s|\"[0-9.]+ wolf\"|\"$lan_ip wolf\"|" $dotfiles/nix/nixos/hosts/pika/default.nix
else
  note "No LAN address found. Set wolf's address in nix/nixos/hosts/pika/default.nix by hand."
fi

git -C $dotfiles add nix/shared.nix nix/nixos/hosts/pika/default.nix
if ! git -C $dotfiles diff --cached --quiet; then
  git -C $dotfiles commit -q -m "chore: trust the new wolf"
  git -C $dotfiles pull -q --rebase --autostash
  git -C $dotfiles push -q
  pause "Run nix-rebuild on elm, pika, oak, sparrow, and your Macs so they trust the new wolf."
fi

step "Codex"
codex login status >/dev/null 2>&1 || codex login

step "Log in automatically after a restart"
# Docker Desktop and the runners only run inside a logged-in session.
if fdesetup isactive >/dev/null 2>&1; then
  if ask "FileVault is on, which blocks automatic login. Turn it off now?"; then
    sudo fdesetup disable
  fi
fi
if ! fdesetup isactive >/dev/null 2>&1 &&
   [[ $(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null) != $user ]]; then
  read -rs "password?Password for $user (turns on automatic login): "
  print
  sudo sysadminctl -autologin set -userName $user -password "$password"
  unset password
fi

step "Docker Desktop"
if ! docker info >/dev/null 2>&1; then
  [[ -f "$HOME/Library/Group Containers/group.com.docker/settings-store.json" ]] ||
    sudo /Applications/Docker.app/Contents/MacOS/install --accept-license --user=$user
  open -a Docker
fi

step "Claude proxy"
if [[ ! -d $rotate/.git ]]; then
  if [[ -d $rotate && -z $(ls -A $rotate) ]]; then rmdir $rotate; fi
  if [[ -e $rotate ]]; then
    mv $rotate $rotate.before-setup
    note "Moved the old $rotate aside to $rotate.before-setup."
  fi
  git clone -q https://github.com/doxaras/claude-rotate.git $rotate
else
  git -C $rotate pull -q --ff-only
fi
if [[ ! -f $rotate/config.json ]]; then
  (cd $rotate && ./setup.sh >/dev/null)
fi
# The example config ships placeholder accounts and devices.
/usr/bin/python3 - $rotate $claude_machines <<'EOF'
import json, os, sys
root, machines = sys.argv[1], sys.argv[2:]
path = os.path.join(root, "config.json")
cfg = json.load(open(path))
cfg["accounts"] = [a for a in cfg.get("accounts", []) if os.path.exists(os.path.join(root, a["token_file"]))]
cfg["devices"] = {k: v for k, v in cfg.get("devices", {}).items() if k in machines and "REPLACE-WITH" not in v}
cfg["public_url"] = "http://wolf:8484"
json.dump(cfg, open(path, "w"), indent=2)
EOF
accounts=$(/usr/bin/python3 -c "import json,sys; print(len(json.load(open(sys.argv[1]))['accounts']))" $rotate/config.json)
if (( accounts == 0 )); then
  note "Add each Claude account. Sign in to it in the browser that opens."
fi
token_out=$(mktemp)
while true; do
  if (( accounts > 0 )); then
    read -r "name?Another Claude account to add (blank to skip): "
    [[ -n $name ]] || break
  else
    read -r "name?Account name: "
    [[ -n $name ]] || continue
  fi
  # A narrow terminal wraps the token, so give setup-token a wide one.
  env -u ANTHROPIC_BASE_URL -u CLAUDE_CODE_OAUTH_TOKEN script -q $token_out zsh -c 'stty cols 400; exec claude setup-token'
  grep -ao 'sk-ant-oat01-[A-Za-z0-9_-]*' $token_out | tail -1 | (cd $rotate && ./setup.sh add-account $name)
  : > $token_out
  accounts=$(( accounts + 1 ))
done
rm -f $token_out
for machine in $claude_machines; do
  [[ -n $(device_key $machine) ]] || (cd $rotate && ./setup.sh add-device $machine >/dev/null)
done
sudo launchctl kickstart -k system/org.nixos.claude-rotate

mkdir -p $HOME/.local/state/claude-rotate
(umask 077 && print -r -- "export ANTHROPIC_BASE_URL=http://127.0.0.1:8484
export CLAUDE_CODE_OAUTH_TOKEN=$(device_key $host)" > $HOME/.local/state/claude-rotate/env)
note "From the Air, write ~/.local/state/claude-rotate/env on ${(j:, :)${claude_machines:#$host}} with
ANTHROPIC_BASE_URL=http://wolf:8484 and that machine's key from $rotate/config.json."

step "GitHub Actions runners"
mkdir -p $runners
for dir in $HOME/actions-runner-<->(N/); do
  url=$(/usr/bin/python3 -c "import json,sys; print(json.load(open(sys.argv[1], encoding='utf-8-sig')).get('gitHubUrl', ''))" $dir/.runner 2>/dev/null || true)
  if ask "Remove the runner in $dir${url:+ (registered to $url)}? It came from the first run of this script."; then
    path=${url#https://github.com/}
    if [[ $path == */* ]]; then api=repos/$path; else api=orgs/$path; fi
    (
      cd $dir
      ./svc.sh stop >/dev/null 2>&1 || true
      ./svc.sh uninstall >/dev/null 2>&1 || true
      if [[ -n $url ]]; then
        ./config.sh remove --token "$(gh api -X POST $api/actions/runners/remove-token --jq .token)"
      fi
    )
    rm -rf $dir
  fi
done
version=$(gh api repos/actions/runner/releases/latest --jq .tag_name)
version=${version#v}
for spec in $runner_specs; do
  repo=${spec%%:*}
  name=${spec#*:}
  dir=$runners/$name
  if [[ -f $dir/.runner ]]; then continue; fi
  mkdir -p $dir
  curl -fsSL https://github.com/actions/runner/releases/download/v$version/actions-runner-osx-arm64-$version.tar.gz | tar xz -C $dir
  token=$(gh api -X POST repos/$repo/actions/runners/registration-token --jq .token)
  (
    cd $dir
    ./config.sh --unattended --replace --url https://github.com/$repo --token $token --name $name
    print "JAVA_HOME=$java_home" >> .env
    ./svc.sh install
    ./svc.sh start
  )
done

step "pass"
if [[ ! -d $HOME/.password-store ]] && ask "Set up pass on wolf?"; then
  $dotfiles/terminal/bin/setup-pass
fi

step "Xcode"
until [[ -d /Applications/Xcode.app ]]; do
  open "macappstores://apps.apple.com/app/id497799835"
  pause "Install Xcode from the App Store, then continue once it finishes."
done
xcode=/Applications/Xcode.app/Contents/Developer
if [[ $(xcode-select -p) != $xcode ]]; then
  sudo xcode-select -s $xcode
  sudo xcodebuild -license accept
  sudo xcodebuild -runFirstLaunch
fi

step "Checks"
failed=0
check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then
    print -P "%F{green}ok%f    $label"
  else
    print -P "%F{red}FAIL%f  $label"
    failed=1
  fi
}
is_host_name() { [[ $(scutil --get ComputerName) == $host && $(scutil --get LocalHostName) == $host && $(scutil --get HostName) == $host ]] }
never_sleeps() { [[ $(pmset -g | awk '$1 == "sleep" {print $2}') == 0 ]] }
dotfiles_linked() { [[ $(readlink $HOME/.zshrc) == *code/dotfiles/terminal/.zshrc ]] }
tailscale_named() { [[ $(tailscale status --json | jq -r .Self.DNSName) == $host.* ]] }
served() { tailscale serve status --json | jq -e ".TCP[\"$1\"]" }
recorded() { grep -qF "${host_key#* }" $dotfiles/nix/shared.nix && grep -qF "\"$tailnet_ip\"" $dotfiles/nix/shared.nix }
auto_login() { [[ $(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser) == $user ]] }
filevault_off() { ! fdesetup isactive }
proxy_answers() { [[ $(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(device_key $host)" http://127.0.0.1:8484/rotate/status) == 200 ]] }
go_cache_local() { [[ ! -L $go_cache ]] }
pip_can_sftp() { dseditgroup -o checkmember -m pip com.apple.access_ssh }
runner_online() { [[ $(gh api repos/$1/actions/runners --jq ".runners[] | select(.name == \"$2\") | .status") == online ]] }

check "named $host" is_host_name
check "Remote Login on" remote_login_on
check "never sleeps" never_sleeps
check "dotfiles linked" dotfiles_linked
check "oh-my-zsh and Powerlevel10k" test -d $p10k
check "GitHub login" gh auth status
check "Tailscale named $host" tailscale_named
check "Tailscale serves the claude proxy (8484)" served 8484
check "Tailscale serves the health sensor (9100)" served 9100
check "health sensor answers" curl -sf http://127.0.0.1:9100/metrics
check "new host key and IP recorded in shared.nix" recorded
check "only the Air and Pro can ssh in" test ! -e $HOME/.ssh/authorized_keys
check "Codex logged in" codex login status
check "claude proxy answers" proxy_answers
check "FileVault off" filevault_off
check "logs in automatically" auto_login
check "Docker running" docker info
check "Docker starts at login" test -f $HOME/Library/LaunchAgents/org.nixos.docker-desktop.plist
check "Go build cache on the internal disk" go_cache_local
check "pip can reach its backups over sftp" pip_can_sftp
for spec in $runner_specs; do
  check "runner ${spec#*:} online for ${spec%%:*}" runner_online ${spec%%:*} ${spec#*:}
done
check "Xcode selected for the runners" xcodebuild -version

if (( failed )); then
  note "\nSomething failed. Fix it, or rerun this script."
  exit 1
fi
print "\nEverything checks out. Restart wolf once to confirm it all comes back on its own."
