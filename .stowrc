--target=$HOME
--ignore='README\.md'
--ignore='\.DS_Store'
--ignore='nix-darwin'
--ignore='fix-ios-dev.sh'
--ignore='otto'
--ignore='\.specs'
--ignore='docs'
--ignore='\.cmuxterm'
--ignore='\.config/(anthropic|cagent|cliproxy|codexbar|composer|gcloud|gh|herd-lite|intelephense|psysh|qBittorrent|raycast|strive)'
--ignore='\.config/herdr/(?!config\.toml\z)[^/]+'
--ignore='\.config/opencode/(?!(opencode\.jsonc|plugins)\z)[^/]+'
--ignore='\.config/worktrunk/(?!config\.toml\z)[^/]+'
--ignore='\.pi/agent/(?!(AGENTS\.md|extensions|models\.json|settings\.json|skills|themes)\z)[^/]+'
--ignore='\.pi/web-search\.json'
